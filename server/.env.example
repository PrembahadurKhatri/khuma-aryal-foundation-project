# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (Database -> Connect -> Drivers).
# Include the database name in the path, e.g. .../khuma-aryal?retryWrites=true...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khuma-aryal?retryWrites=true&w=majority

# Any long random strings — used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Origin(s) allowed to call this API, comma-separated. The Vite dev server
# runs on 5173 by default.
CLIENT_URL=http://localhost:5173

PORT=5001
NODE_ENV=development

# Hardcoded fallback admin login (see utils/fallbackAdmin.js) — lets
# /admin/login work even before MongoDB is configured/seeded. Change these
# once you've logged in and set a real admin password.
FALLBACK_ADMIN_EMAIL=admin@khumaaryalfoundation.org
FALLBACK_ADMIN_PASSWORD=ChangeMe123!

# Cloudinary (image uploads — see middleware/upload.js). Optional: if any of
# these three are unset, uploads fall back to local disk (server/uploads/)
# automatically. Get these from your Cloudinary dashboard's "API Keys" page —
# the cloud name is just the short name, NOT "Cloud name: xxxxx".
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend HTTP API — see utils/sendEmail.js). Optional: if unset, the
# public contact form still saves messages to the database, it just skips
# sending a notification email. Get a key at https://resend.com (API Keys),
# and verify your From domain under Domains (or send from
# onboarding@resend.dev unverified, for testing only).
RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM's address MUST be on a domain verified in your Resend account.
EMAIL_FROM="Khuma Aryal Foundation <noreply@yourdomain.com>"
